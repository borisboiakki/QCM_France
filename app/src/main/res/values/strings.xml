    <!-- Aide -->
    <string name="help_title">Aide</string>
    <string name="help_about_title">À propos</string>
    <string name="help_about_text">QCM France vous aide à préparer l\'examen civique de naturalisation française. L\'application propose deux modes complémentaires :\n\n• Mode examen : 40 questions tirées aléatoirement (28 questions de connaissances + 12 questions de mise en situation), 45 minutes au chronomètre, sans correction immédiate — comme dans les conditions officielles.\n\n• Mode S\'entraîner : parcourez toutes les questions d\'un thème, une par une, avec correction immédiate, explication et lien vers la source après chaque réponse confirmée.</string>
    <string name="help_rules_title">Règles de l\'examen officiel</string>
    <string name="help_themes_title">Thèmes couverts</string>
    <string name="help_theme_1">Principes et valeurs de la République</string>
    <string name="help_theme_2">Système institutionnel et politique</string>
    <string name="help_theme_3">Droits et devoirs</string>
    <string name="help_theme_4">Histoire, géographie et culture</string>
    <string name="help_theme_5">Vivre dans la société française</string>
    <string name="help_theme_count">%1$d questions</string>
    <string name="help_exam_title">Mode examen</string>
    <string name="help_exam_timer_title">Chronomètre</string>
    <string name="help_exam_timer_desc">Décompte de 45 min, affiché en rouge dans les 5 dernières minutes. Soumission automatique à 00:00.</string>
    <string name="help_exam_situation_title">Questions de mise en situation</string>
    <string name="help_exam_situation_desc">12 des 40 questions décrivent un cas concret de la vie quotidienne (voisinage, travail, discrimination, urgence…) et vous demandent de choisir la réaction la plus appropriée, en plus des 28 questions de connaissances classiques.</string>
    <string name="help_exam_rotation_title">Rotation des questions</string>
    <string name="help_exam_rotation_desc">Pour chaque thème, l\'application fait tourner l\'ensemble des questions disponibles : toutes sont utilisées une fois avant qu\'une répétition ne survienne d\'un examen à l\'autre.</string>
    <string name="help_exam_pause_title">Pause et reprise</string>
    <string name="help_exam_pause_desc">Mettez l\'examen en pause via le bouton Pause ou la touche Retour. L\'état est sauvegardé et vous pouvez reprendre plus tard, même après avoir fermé l\'application.</string>
    <string name="help_exam_history_title">Historique</string>
    <string name="help_exam_history_desc">Consultez tous vos examens passés avec le score, la durée et la mention obtenue.</string>
    <string name="help_exam_export_title">Export des résultats</string>
    <string name="help_exam_export_desc">Partagez le détail de votre examen (question par question) via les applications installées sur votre téléphone.</string>
    <string name="help_training_title">Mode S\'entraîner</string>
    <string name="help_training_intro">Un mode d\'apprentissage complémentaire à l\'examen, sans chronomètre et avec correction immédiate.</string>
    <string name="help_training_theme_title">Choix du thème</string>
    <string name="help_training_theme_desc">Sélectionnez l\'un des 5 thèmes officiels. Une barre de progression indique combien de questions vous avez déjà vues dans ce thème.</string>
    <string name="help_training_confirm_title">Confirmer pour révéler</string>
    <string name="help_training_confirm_desc">Choisissez une réponse — vous pouvez la modifier tant que vous n\'avez pas appuyé sur « Confirmer ». Une fois confirmée, la bonne réponse apparaît en vert et une mauvaise sélection en rouge.</string>
    <string name="help_training_source_title">Explication et source</string>
    <string name="help_training_source_desc">Après confirmation, une explication est affichée (si disponible) ainsi qu\'un lien vers la source officielle, ouvrant votre navigateur.</string>
    <string name="help_training_progress_title">Avancement persisté</string>
    <string name="help_training_progress_desc">Votre progression est sauvegardée question par question. Revenir en arrière ou fermer l\'application ne fait pas perdre votre avancement — le thème reprend exactement là où vous vous étiez arrêté.</string>
    <string name="help_training_reset_title">Réinitialisation</string>
    <string name="help_training_reset_desc">Depuis les Paramètres, réinitialisez la progression de tous les thèmes en une seule action.</string>
    <string name="help_achievements_title">Succès</string>
    <string name="help_achievements_intro">Débloquez des succès en progressant dans l\'application, comme des trophées de jeu vidéo. Un bandeau apparaît à chaque déblocage.</string>
    <string name="help_achievements_exam_title">Succès d\'examen</string>
    <string name="help_achievements_exam_desc">Terminer votre premier examen, en réussir un (≥ 32/40), obtenir un score parfait (40/40) et voir passer toutes les questions de la base au moins une fois.</string>
    <string name="help_achievements_training_title">Succès d\'entraînement</string>
    <string name="help_achievements_training_desc">Un succès pour chaque thème d\'entraînement terminé, plus un succès spécial une fois les 5 thèmes complétés.</string>
    <string name="help_achievements_page_title">Page « Succès »</string>
    <string name="help_achievements_page_desc">Accessible depuis l\'accueil : consultez les succès débloqués, la progression des succès en cours (barre X/total) et la date de déblocage. Les succès non obtenus restent verrouillés.</string>
    <string name="help_settings_title">Paramètres</string>
    <string name="help_settings_theme_title">Thème visuel</string>
    <string name="help_settings_theme_desc">Choisissez entre le thème du système, clair ou sombre — persisté entre les sessions.</string>
    <string name="help_settings_sound_title">Son de sélection</string>
    <string name="help_settings_sound_desc">Activez ou désactivez le bip joué lors de la sélection d\'une réponse en examen.</string>
    <string name="help_settings_reset_training_title">Réinitialiser l\'entraînement</string>
    <string name="help_settings_reset_training_desc">Efface la progression de tous les thèmes du mode S\'entraîner (action irréversible, avec confirmation).</string>
    <string name="help_settings_reset_cycle_title">Réinitialiser le cycle de l\'examen</string>
    <string name="help_settings_reset_cycle_desc">Relance depuis le début la rotation anti-répétition des questions de l\'examen, pour chaque thème (action irréversible, avec confirmation).</string>
    <string name="help_settings_reset_achievements_title">Réinitialiser les succès</string>
    <string name="help_settings_reset_achievements_desc">Efface tous les succès débloqués et leur progression (action irréversible, avec confirmation).</string>
